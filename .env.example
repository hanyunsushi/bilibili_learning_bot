# Copy this file to .env and fill private values locally.
# Do not commit .env.

# Web panel
BILI_ACCOUNT_NAME=默认
BILI_LEARNING_PANEL_PASSWORD=

# OpenAI-compatible AI provider
BILI_AI_API_KEY=
BILI_AI_BASE_URL=https://api.openai.com/v1
BILI_AI_MODEL_BRAIN=gpt-4.1-mini
BILI_AI_MODEL_VISION=gpt-4.1-mini
BILI_AI_MODEL_CHAT=gpt-4.1-mini
BILI_AI_MODEL_FAST=gpt-4.1-nano
BILI_AI_MODEL_IMAGE=gpt-image-1
BILI_AI_MODEL_EMBEDDING=text-embedding-3-small

# Optional fallback provider
BILI_AI_FALLBACK_API_KEY=
BILI_AI_FALLBACK_BASE_URL=

# Bilibili login token, normally configured by Web panel QR login.
BILI_REFRESH_TOKEN=

# Reply marker
BILI_AI_MARKER=（内容由AI生成并由AI回复）
